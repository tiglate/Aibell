<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Authors>Tiglate Pileser III</Authors>
    <Copyright>Copyright (c) 2026 Tiglate Pileser III.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!--
    z440.atl.core depends on Ude.NetStandard (charset detection), whose license terms cannot be verified from the package.
    This product accepts no dependency with unclear or GPL-family terms, so every project that restores ATL (directly or through
    Aibell.Infrastructure) excludes the package's assets: it is never compiled against, copied or shipped.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Aibell.Infrastructure' or '$(MSBuildProjectName)' == 'Aibell.Desktop' or '$(MSBuildProjectName)' == 'Aibell.Infrastructure.Tests' or '$(MSBuildProjectName)' == 'Aibell.Desktop.Tests' or '$(MSBuildProjectName)' == 'Aibell.Desktop.UiTests'">
    <PackageReference Include="Ude.NetStandard" ExcludeAssets="all" />
  </ItemGroup>
</Project>
