<UserControl
    x:Class="Aibell.Desktop.DiscView"
    x:DataType="viewModels:DiscViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Aibell.Desktop.ViewModels"
    xmlns:discs="using:Aibell.Application.Discs"
    xmlns:enrichment="using:Aibell.Application.Enrichment"
    xmlns:loc="using:Aibell.Desktop.Localization"
    Name="DiscViewRoot">
  <Grid RowDefinitions="Auto,*,28">
    <Border Padding="10" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <ComboBox Name="DriveChoice" MinWidth="220" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding HasDrives}"
                  AutomationProperties.Name="{loc:T Disc.DriveAutomation}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="discs:OpticalDrive"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Name="RefreshDisc" Content="{loc:T Disc.Read}" IsEnabled="{Binding CanRefresh}" Click="Refresh" ToolTip.Tip="{loc:T Disc.ReadTip}" />
        <Button Name="LookUpDisc" Content="{loc:T Disc.LookUp}" Classes="dialogAccept" IsEnabled="{Binding CanLookUp}" Click="LookUp" ToolTip.Tip="{Binding LookupHint}" />
        <Button Name="CancelDiscOperation" Content="{loc:T Common.Cancel}" IsVisible="{Binding IsBusy}" Click="CancelOperation" />
      </WrapPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,260">
      <Grid>
        <ListBox Name="DiscTrackList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0"
                 Background="{DynamicResource ContentBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{loc:T Disc.TracksAutomation}" DoubleTapped="TrackDoubleTapped">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="viewModels:DiscTrackRow">
              <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" Margin="8,4">
                <TextBlock Text="{Binding Number}" Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Artist}" Classes="secondary" FontSize="11" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Length}" Classes="secondary" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Classes="secondary"
                   IsVisible="{Binding !HasDisc}" Text="{loc:T Disc.Empty}" />
      </Grid>
      <Border Grid.Column="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource ContentBrush}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="8">
            <Border Width="180" Height="180" HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource PanelHeaderBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
              <Grid>
                <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNotNull}}"
                       AutomationProperties.Name="{loc:T Disc.CoverAutomation}" />
                <TextBlock Text="♫" FontSize="56" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding AlbumTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AlbumDetails}" Classes="secondary" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasSeveralReleases}" Spacing="4">
              <TextBlock Text="{loc:T Disc.OtherAlbums}" Classes="secondary" FontSize="11" />
              <ComboBox Name="ReleaseChoice" HorizontalAlignment="Stretch" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}"
                        SelectionChanged="ReleaseChosen" AutomationProperties.Name="{loc:T Disc.PossibleAlbums}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="enrichment:ReleaseCandidate"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <Button Name="ShowArtist" Content="{loc:T Disc.Artist}" IsEnabled="{Binding CanShowArtist}" Click="ShowArtistInfo"
                    ToolTip.Tip="{loc:T Disc.ArtistTip}" />
            <TextBlock Name="ArtistDetailsText" Text="{Binding ArtistDetails}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
      <TextBlock Name="DiscStatus" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</UserControl>
